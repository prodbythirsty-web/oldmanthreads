<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Old Man Threads — Checkout</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<script src="https://js.stripe.com/v3/"></script>
<style>
/* ── RESET & ROOT ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bark: #3D2B1F;
  --bark-light: #6B4C3B;
  --moss: #5C6B3A;
  --petal: #C4856A;
  --linen: #D9CDB8;
  --linen-dark: #B8A99A;
  --cream: #F5EFE0;
  --warm-white: #FAF7F2;
  --sidebar-bg: #F3F4F6;
  --gold: #C4954A;
  --r6: 6px;
  --r8: 8px;
  --r12: 12px;
}
html { scroll-behavior: smooth; }
body {
  font-family: 'Lato', sans-serif;
  font-size: 14px;
  color: #1a1a1a;
  background: #fff;
  min-height: 100vh;
}
a { color: inherit; }

/* ── TOP HEADER ── */
.co-header {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
  padding: 16px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.co-header .logo {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--bark);
  text-decoration: none;
}
.co-header .logo span {
  font-size: 10px;
  display: block;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--linen-dark);
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  margin-top: 1px;
}
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #6b7280;
}
.breadcrumb a { color: #5c7cfa; text-decoration: none; }
.breadcrumb .sep { color: #d1d5db; }

/* ── LAYOUT: left form | right sidebar ── */
.co-layout {
  display: flex;
  min-height: calc(100vh - 65px);
  align-items: flex-start;
}
.co-left {
  flex: 1 1 0;
  padding: 40px 48px 80px;
  background: #fff;
  max-width: 620px;
}
.co-right {
  width: 380px;
  flex-shrink: 0;
  background: var(--sidebar-bg);
  border-left: 1px solid #e5e7eb;
  padding: 40px 36px 80px;
  position: sticky;
  top: 0;
  min-height: calc(100vh - 65px);
  max-height: 100vh;
  overflow-y: auto;
}

/* ── SECTION LABELS ── */
.sec-label {
  font-size: 22px;
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  color: var(--bark);
  margin-bottom: 20px;
}
.sub-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #6b7280;
  margin: 28px 0 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e5e7eb;
}
.sub-label:first-of-type { margin-top: 0; }

/* ── EXPRESS CHECKOUT ── */
.express-label {
  text-align: center;
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #9ca3af;
  margin-bottom: 14px;
}
.express-btns {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  margin-bottom: 20px;
}
.express-btn {
  border: 1.5px solid #e5e7eb;
  border-radius: var(--r8);
  padding: 11px 8px;
  background: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color .2s, box-shadow .2s;
  height: 48px;
}
.express-btn:hover { border-color: #9ca3af; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
.express-btn svg { height: 22px; display: block; }
/* Shop Pay */
.express-btn.shop-pay { background: #5433EB; border-color: #5433EB; }
.express-btn.shop-pay span { color: #fff; font-weight: 700; font-size: 14px; letter-spacing: -.01em; }
/* Apple Pay */
.express-btn.apple-pay { background: #000; border-color: #000; }
.express-btn.apple-pay span { color: #fff; font-size: 16px; letter-spacing: .02em; }
/* Google Pay */
.express-btn.google-pay { background: #fff; }

.divider {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #9ca3af;
  font-size: 12px;
  margin: 16px 0 24px;
}
.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #e5e7eb;
}

/* ── FORM ── */
.form-row { display: flex; gap: 12px; margin-bottom: 14px; }
.form-row.col-1 { flex-direction: column; }
.form-group { display: flex; flex-direction: column; flex: 1; gap: 5px; }
.form-group label {
  font-size: 13px;
  color: #374151;
  font-weight: 400;
}
.form-group input,
.form-group select {
  padding: 12px 14px;
  border: 1.5px solid #d1d5db;
  border-radius: var(--r6);
  font-family: 'Lato', sans-serif;
  font-size: 14px;
  color: #1a1a1a;
  background: #fff;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
  width: 100%;
}
.form-group input:focus,
.form-group select:focus {
  border-color: #374151;
  box-shadow: 0 0 0 3px rgba(55,65,81,.08);
}
.form-group .field-err {
  font-size: 11px;
  color: var(--petal);
  display: none;
}
.form-group.has-err .field-err { display: block; }
.form-group.has-err input,
.form-group.has-err select { border-color: var(--petal); }

/* checkbox row */
.check-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 6px;
  font-size: 13px;
  color: #374151;
  cursor: pointer;
}
.check-row input[type=checkbox] {
  accent-color: var(--moss);
  width: 16px;
  height: 16px;
  cursor: pointer;
  flex-shrink: 0;
}

/* ── SHIPPING METHOD BOX ── */
.shipping-method-box {
  border: 1px solid #e5e7eb;
  border-radius: var(--r8);
  padding: 18px 16px;
  color: #9ca3af;
  font-size: 13px;
  background: #fff;
  min-height: 58px;
  display: flex;
  align-items: center;
}

/* ── SECURE CHECKOUT NOTICE ── */
.secure-notice {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: var(--r8);
  padding: 16px 18px;
  font-size: 12px;
  color: #6b7280;
  line-height: 1.6;
  margin: 24px 0 20px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.secure-notice .lock-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }

/* ── PAYMENT SECTION ── */
.payment-option {
  border: 1.5px solid #e5e7eb;
  border-radius: var(--r8);
  overflow: hidden;
  margin-bottom: 10px;
  background: #fff;
}
.payment-option-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  cursor: pointer;
}
.payment-option-left {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 700;
  color: #1a1a1a;
}
.pay-radio {
  width: 18px;
  height: 18px;
  border: 2px solid #d1d5db;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: border-color .2s;
}
.pay-radio.active { border-color: #1a1a1a; }
.pay-radio .dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #1a1a1a;
  opacity: 0;
  transform: scale(.3);
  transition: opacity .2s, transform .2s;
}
.pay-radio.active .dot { opacity: 1; transform: scale(1); }
.card-logos { display: flex; gap: 5px; align-items: center; }
.card-logo {
  height: 22px;
  border-radius: 3px;
  border: 1px solid #e5e7eb;
  background: #fff;
  padding: 2px 5px;
  font-size: 9px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a1a;
  letter-spacing: .02em;
}
.card-logo.visa { color: #1a1f71; }
.card-logo.mc { color: #eb001b; }
.card-logo.amex { color: #007bc1; }
.more-cards { font-size: 10px; color: #9ca3af; }

.payment-option-body {
  padding: 0 16px 16px;
  border-top: 1px solid #e5e7eb;
  display: none;
}
.payment-option-body.open { display: block; padding-top: 16px; }

/* Stripe Element containers */
.stripe-element-wrap {
  padding: 12px 14px;
  border: 1.5px solid #d1d5db;
  border-radius: var(--r6);
  background: #fff;
  transition: border-color .2s, box-shadow .2s;
  min-height: 44px;
}
.stripe-element-wrap.StripeElement--focus {
  border-color: #374151;
  box-shadow: 0 0 0 3px rgba(55,65,81,.08);
}
.stripe-element-wrap.StripeElement--invalid {
  border-color: var(--petal);
}
.stripe-row { display: flex; gap: 12px; }
.stripe-row .stripe-element-wrap { flex: 1; }

/* billing checkbox */
.billing-check {
  margin-top: 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: #374151;
  cursor: pointer;
}
.billing-check input { accent-color: var(--moss); width: 16px; height: 16px; cursor: pointer; }

/* shop pay info row */
.shop-pay-info {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: #6b7280;
  padding: 14px 0 0;
}
.shop-pay-info .sp-logo {
  background: #5433EB;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
  flex-shrink: 0;
}
.shop-pay-info .sp-dot { color: #d1d5db; }

/* ── PLACE ORDER BUTTON ── */
.place-order-btn {
  width: 100%;
  padding: 18px;
  background: var(--bark);
  color: var(--cream);
  border: none;
  border-radius: var(--r8);
  font-family: 'Lato', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background .22s, transform .15s;
  box-shadow: 0 4px 18px rgba(61,43,31,.28);
  margin-top: 24px;
  position: relative;
  overflow: hidden;
}
.place-order-btn:hover:not(:disabled) { background: var(--bark-light); transform: translateY(-1px); }
.place-order-btn:disabled { opacity: .65; cursor: not-allowed; transform: none; }

.pay-terms {
  font-size: 11px;
  color: #9ca3af;
  margin-top: 14px;
  line-height: 1.6;
  text-align: center;
}
.pay-terms a { color: #5c7cfa; text-decoration: underline; }

/* ── ERROR MESSAGE ── */
#stripe-error {
  color: var(--petal);
  font-size: 13px;
  margin-top: 10px;
  display: none;
}
#stripe-error.show { display: block; }

/* ── RIGHT SIDEBAR ── */
.sidebar-toggle {
  display: none;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid #e5e7eb;
  cursor: pointer;
  font-size: 13px;
  font-weight: 700;
  color: #5c7cfa;
  margin-bottom: 24px;
}
.sidebar-toggle .toggle-total { color: #1a1a1a; }

.order-items { margin-bottom: 24px; }
.order-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  margin-bottom: 16px;
  position: relative;
}
.order-item-img {
  width: 64px;
  height: 64px;
  border-radius: 8px;
  object-fit: cover;
  border: 1px solid #e5e7eb;
  background: var(--cream);
  flex-shrink: 0;
  position: relative;
}
.order-item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 7px;
  display: block;
}
.item-qty-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  background: #6b7280;
  color: #fff;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--sidebar-bg);
}
.order-item-info { flex: 1; }
.order-item-name { font-size: 13px; font-weight: 700; color: #1a1a1a; margin-bottom: 2px; }
.order-item-variant { font-size: 12px; color: #6b7280; }
.order-item-price { font-size: 13px; font-weight: 700; color: #1a1a1a; white-space: nowrap; }

.sidebar-divider { height: 1px; background: #e5e7eb; margin: 20px 0; }

.discount-row {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
}
.discount-row input {
  flex: 1;
  padding: 11px 14px;
  border: 1.5px solid #d1d5db;
  border-radius: var(--r6);
  font-size: 13px;
  color: #1a1a1a;
  outline: none;
  transition: border-color .2s;
  font-family: 'Lato', sans-serif;
}
.discount-row input:focus { border-color: #374151; }
.discount-row button {
  padding: 11px 20px;
  background: #fff;
  border: 1.5px solid #d1d5db;
  border-radius: var(--r6);
  font-size: 13px;
  font-weight: 700;
  color: #374151;
  cursor: pointer;
  transition: background .2s;
  white-space: nowrap;
  font-family: 'Lato', sans-serif;
}
.discount-row button:hover { background: #f9fafb; }

.totals-row {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #374151;
  margin-bottom: 10px;
}
.totals-row.shipping .val { color: var(--moss); font-weight: 700; }
.totals-row.grand {
  font-size: 18px;
  font-weight: 700;
  color: #1a1a1a;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid #e5e7eb;
  align-items: center;
}
.totals-row.grand .currency {
  font-size: 12px;
  color: #9ca3af;
  font-weight: 400;
  margin-right: 4px;
}
.totals-row.grand .amount { font-size: 20px; }

/* ── SUCCESS ── */
.success-wrap {
  display: none;
  text-align: center;
  padding: 60px 40px;
}
.success-wrap.show { display: block; }
.success-icon {
  width: 80px;
  height: 80px;
  background: var(--moss);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  color: #fff;
  margin: 0 auto 24px;
}
.success-wrap h2 { font-family: 'Playfair Display', serif; font-size: 28px; color: var(--bark); margin-bottom: 12px; }
.success-wrap p { color: var(--bark-light); font-size: 15px; line-height: 1.7; margin-bottom: 28px; }
.success-back-btn {
  padding: 14px 36px;
  background: var(--bark);
  color: var(--cream);
  border: none;
  border-radius: var(--r8);
  font-family: 'Lato', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  cursor: pointer;
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .co-layout { flex-direction: column-reverse; }
  .co-right {
    width: 100%;
    position: relative;
    min-height: auto;
    max-height: none;
    border-left: none;
    border-bottom: 1px solid #e5e7eb;
  }
  .co-left { padding: 28px 20px 60px; max-width: 100%; }
  .sidebar-toggle { display: flex; }
  .order-items, .discount-row, .sidebar-divider { display: none; }
  .order-items.visible, .discount-row.visible, .sidebar-divider.visible { display: flex; }
  .order-items.visible { display: block; }
  .sidebar-divider.visible { display: block; }
}
@media (max-width: 520px) {
  .express-btns { grid-template-columns: 1fr 1fr; }
  .co-header { padding: 14px 16px; }
  .stripe-row { flex-direction: column; }
}
</style>
</head>
<body>

<!-- ── HEADER ── -->
<header class="co-header">
  <a href="/" class="logo">
    Old Man Threads
    <span>Handcrafted Since Always</span>
  </a>
  <nav class="breadcrumb">
    <a href="/">Cart</a>
    <span class="sep">›</span>
    <strong>Information</strong>
    <span class="sep">›</span>
    <span style="color:#9ca3af">Payment</span>
  </nav>
</header>

<!-- ── MAIN LAYOUT ── -->
<div class="co-layout">

  <!-- LEFT: FORM -->
  <div class="co-left" id="form-section">

    <!-- SUCCESS -->
    <div class="success-wrap" id="success-wrap">
      <div class="success-icon">✓</div>
      <h2>Order Placed! 🎉</h2>
      <p>Thank you! Your handcrafted bag is being carefully prepared and will ship soon. You'll receive a confirmation email with tracking shortly.</p>
      <button class="success-back-btn" onclick="window.location.href='/'">Back to Shop</button>
    </div>

    <div id="checkout-form">
      <div class="sec-label">Express checkout</div>

      <!-- Express Buttons -->
      <div class="express-btns">
        <button class="express-btn shop-pay" onclick="handleShopPay()" title="Shop Pay">
          <span>shop</span>
        </button>
        <button class="express-btn apple-pay" onclick="handleApplePay()" title="Apple Pay">
          <span>&#xF8FF; Pay</span>
        </button>
        <button class="express-btn google-pay" onclick="handleGooglePay()" title="Google Pay">
          <svg viewBox="0 0 41 17" xmlns="http://www.w3.org/2000/svg" aria-label="Google Pay">
            <path d="M19.526 2.635v4.083h2.518c.6 0 1.096-.202 1.488-.605.403-.402.605-.882.605-1.437 0-.544-.202-1.018-.605-1.422-.392-.413-.888-.62-1.488-.62h-2.518zm0 5.52v4.736h-1.504V1.198h3.99c1.013 0 1.873.337 2.582 1.012.72.675 1.08 1.497 1.08 2.466 0 .991-.36 1.819-1.08 2.482-.697.665-1.559.996-2.582.996h-2.486v.001zM27.194 10.442c0 .392.166.718.499.98.332.26.722.391 1.168.391.633 0 1.196-.234 1.692-.701.497-.469.744-1.019.744-1.65-.469-.37-1.123-.555-1.962-.555-.61 0-1.12.148-1.528.442-.409.294-.613.657-.613 1.093m1.946-5.815c1.112 0 1.989.297 2.633.89.642.594.964 1.408.964 2.442v4.932h-1.438v-1.11h-.065c-.622.914-1.45 1.372-2.486 1.372-.882 0-1.621-.262-2.215-.784-.594-.523-.891-1.176-.891-1.96 0-.828.313-1.486.94-1.976s1.463-.735 2.51-.735c.892 0 1.629.163 2.206.49v-.344c0-.522-.207-.966-.621-1.33a2.132 2.132 0 0 0-1.455-.547c-.84 0-1.504.353-1.995 1.062l-1.324-.834c.73-1.045 1.81-1.568 3.237-1.568m9.93.276-5.03 11.539h-1.554l1.865-4.04-3.305-7.499h1.635l2.387 5.749h.032l2.322-5.749z" fill="#3c4043"/>
            <path d="M13.584 7.448c0-.483-.042-.949-.121-1.4H6.977v2.65h3.705a3.17 3.17 0 0 1-1.37 2.077v1.701h2.207c1.292-1.19 2.065-2.945 2.065-5.028" fill="#4285f4"/>
            <path d="M6.977 14.49c1.846 0 3.396-.61 4.527-1.657l-2.207-1.701c-.617.414-1.407.657-2.32.657-1.781 0-3.294-1.202-3.834-2.82H.867v1.756a6.818 6.818 0 0 0 6.11 3.765" fill="#34a853"/>
            <path d="M3.143 8.969a4.097 4.097 0 0 1 0-2.617V4.596H.867a6.819 6.819 0 0 0 0 6.129l2.276-1.756z" fill="#fabb05"/>
            <path d="M6.977 3.532c1.003 0 1.904.345 2.613 1.021l1.944-1.944C10.368 1.53 8.818.86 6.977.86A6.818 6.818 0 0 0 .867 4.596L3.143 6.35c.54-1.617 2.053-2.818 3.834-2.818" fill="#e94235"/>
          </svg>
        </button>
      </div>

      <div class="divider">OR</div>

      <!-- ── CONTACT ── -->
      <div class="sub-label">Email or Phone</div>
      <div class="form-row col-1">
        <div class="form-group" id="fg-em">
          <input type="email" id="f-em" autocomplete="email" placeholder="Email or phone number">
          <span class="field-err">Valid email required</span>
        </div>
      </div>
      <label class="check-row">
        <input type="checkbox" id="tracking-optin" checked>
        Send me live tracking and order updates
      </label>

      <!-- ── DELIVERY ── -->
      <div class="sub-label" style="margin-top:28px">Delivery</div>

      <div class="form-row col-1" style="margin-bottom:10px">
        <div class="form-group">
          <select id="f-co" autocomplete="country">
            <option value="US" selected>United States</option>
            <option value="AF">Afghanistan</option>
            <option value="AL">Albania</option>
